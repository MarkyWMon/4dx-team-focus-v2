rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safely retrieves member data. If the document doesn't exist yet (first login),
    // it returns a dummy role to prevent the rules engine from erroring out.
    function getMemberData() {
      let path = /databases/$(database)/documents/members/$(request.auth.uid);
      return exists(path) ? get(path).data : {"role": "NONE"};
    }

    // Only accounts on the college domain may use the app, even if they can
    // authenticate through the Azure tenant (e.g. guest accounts).
    function isCollegeUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@bhasvic[.]ac[.]uk$');
    }

    function isAdmin() {
      return isCollegeUser() && getMemberData().role == 'ADMIN';
    }

    function isManager() {
      return isCollegeUser() && (getMemberData().role == 'MANAGER' || getMemberData().role == 'ADMIN');
    }

    // --- Members Collection ---
    match /members/{memberId} {
      // Only Managers and Admins can list all members.
      // Individual users can read their own record.
      allow read: if isCollegeUser() && (request.auth.uid == memberId || isManager());
      allow list: if isManager();

      // CREATE: Self-registration may only create a STAFF record for the
      // signed-in identity (role upgrades are done by an Admin afterwards).
      // Managers/Admins can create invite records for others.
      allow create: if isManager() || (
        isCollegeUser()
        && request.auth.uid == memberId
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == 'STAFF'
      );

      // UPDATE: Owners can update their own profile/gamification fields but can
      // NEVER change their own role or email (privilege escalation). Admins can
      // manage anyone.
      allow update: if isAdmin() || (
        isCollegeUser()
        && request.auth.uid == memberId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email'])
      );

      // DELETE: Only Admins can purge users
      allow delete: if isAdmin();
    }

    // ... (commitments, lead_measures, audit_logs rows stay same) ...
    // --- Commitments Collection ---
    match /commitments/{commitmentId} {
      allow read: if isCollegeUser();
      allow create: if isCollegeUser() && request.resource.data.memberId == request.auth.uid;
      // Owners can update their own commitments but can NEVER stamp manager
      // verification fields on them; managers can do both.
      allow update: if isManager() || (
        isCollegeUser()
        && resource.data.memberId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedBy', 'verifiedAt', 'verifiedInSessionId'])
      );
      allow delete: if isCollegeUser() && (resource.data.memberId == request.auth.uid || isAdmin());
    }

    // --- Lead Measures ---
    match /lead_measures/{measureId} {
      allow read: if isCollegeUser();
      allow write: if isManager();
    }

    // --- Audit Logs ---
    match /audit_logs/{logId} {
      allow read: if isManager();
      // Only allow creation of new logs, no updates or deletes.
      // Validate required fields to prevent log injection.
      allow create: if isCollegeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'userName', 'timestamp'])
        && request.resource.data.keys().size() <= 4;  // id, userId, userName, timestamp
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow read: if isCollegeUser();
      allow write: if isManager();
    }

    // --- WIG Sessions ---
    match /wig_sessions/{sessionId} {
      allow read: if isCollegeUser();
      allow write: if isManager();
    }

    // --- Tickets ---
    match /tickets/{ticketId} {
      allow read: if isCollegeUser();
      // Only Managers/Admins can import or modify tickets
      allow write: if isManager();
    }

    // --- Shared Daily Inspirations (AI Cache) ---
    match /daily_inspirations/{dateId} {
      allow read: if isCollegeUser();
      // Only managers/admins can save new inspirations
      allow write: if isManager();
    }

    // --- Commitment Templates ---
    match /commitment_templates/{templateId} {
      allow read: if isCollegeUser();
      allow write: if isManager();
    }

    // --- Survey Data ---
    match /surveys/{surveyId} {
      allow read: if isCollegeUser();
      // Only Managers/Admins can upload or modify survey data
      allow write: if isManager();
    }

    // --- AI Insights (Weekly Summaries) ---
    match /insights/{insightId} {
      allow read: if isCollegeUser();
      allow write: if isManager();
    }
    
    // Global Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}