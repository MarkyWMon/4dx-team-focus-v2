# NOTE: The Gemini API key is NOT set here. Any VITE_* variable ships in the
# browser bundle, so the key lives server-side only: set GEMINI_API_KEY (and
# WHD_API_KEY / ALLOWED_EMAIL_DOMAIN) as env vars on the Cloud Run proxy.

# Email domain allowed to sign in (client-side check; firestore.rules enforces it)
VITE_ALLOWED_EMAIL_DOMAIN=bhasvic.ac.uk

# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your Apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Azure AD Configuration (for Microsoft SSO)
VITE_AZURE_CLIENT_ID=your_azure_client_id_here
VITE_AZURE_TENANT_ID=your_azure_tenant_id_here


